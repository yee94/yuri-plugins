{
  "name": "yuri-plugins-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "type-check": "pnpm -r --if-present type-check",
    "lint": "pnpm -r lint && biome check package.json biome.json",
    "test": "pnpm -r test",
    "check": "pnpm lint && pnpm -r check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.1",
    "@types/node": "^22.0.0",
    "tsdown": "^0.17.4",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
